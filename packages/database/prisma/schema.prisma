// packages/database/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTITY DOMAIN
// ============================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  firstName       String
  middleName      String?
  lastName        String
  username        String?   @unique
  avatarUrl       String?
  status          String    @default("ACTIVE")
  kycStatus       String    @default("NOT_STARTED")
  accountType     String    @default("USER")
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  profile         UserProfile?
  roles           UserRole[]
  sessions        UserSession[]
  twoFactor       TwoFactorAuth?
  kycApplications KycApplication[]
  brokerAccounts  BrokerAccount[]
  signalSources   SignalSource[]
  providerSubs    ProviderSubscription[]
  trades          Trade[]
  referrals       ReferralRelationship[] @relation("Referrer")
  referredBy      ReferralRelationship[] @relation("Referred")
  referralCode    ReferralCode?
  subscriptions   Subscription[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([kycStatus])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  tradingExperience String?
  languages         String[]
  country           String?
  address           String?
  bio               String?
  preferences       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  roleId      String
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  refreshToken String?
  deviceInfo   Json?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model TwoFactorAuth {
  id            String    @id @default(uuid())
  userId        String    @unique
  secret        String
  enabled       Boolean   @default(false)
  verifiedAt    DateTime?
  recoveryCodes String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

// ============================================
// KYC DOMAIN
// ============================================

model KycApplication {
  id                String    @id @default(uuid())
  userId            String
  status            String    @default("PENDING")
  provider          String?
  providerReference String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  rejectionReason   String?
  reviewNotes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     KycDocument[]
  verifications KycVerification[]
  auditLogs     KycAuditLog[]

  @@index([userId])
  @@index([status])
  @@map("kyc_applications")
}

model KycDocumentType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents KycDocument[]

  @@map("kyc_document_types")
}

model KycDocument {
  id             String    @id @default(uuid())
  applicationId  String
  documentTypeId String
  documentNumber String? // encrypted
  storageKey     String // S3 key
  fileName       String
  fileType       String
  fileSize       Int
  uploadedAt     DateTime  @default(now())
  verifiedAt     DateTime?

  application  KycApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType KycDocumentType @relation(fields: [documentTypeId], references: [id])

  @@map("kyc_documents")
}

model KycVerification {
  id            String    @id @default(uuid())
  applicationId String
  documentCheck Boolean   @default(false)
  identityCheck Boolean   @default(false)
  livenessCheck Boolean   @default(false)
  nameMatch     Boolean   @default(false)
  dobMatch      Boolean   @default(false)
  riskScore     Int?
  result        String?
  verifiedAt    DateTime?

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("kyc_verifications")
}

model KycAuditLog {
  id            String   @id @default(uuid())
  applicationId String
  actorId       String
  action        String
  oldStatus     String?
  newStatus     String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("kyc_audit_logs")
}

// ============================================
// BROKER DOMAIN
// ============================================

model Broker {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts BrokerAccount[]

  @@map("brokers")
}

model BrokerAccount {
  id               String    @id @default(uuid())
  userId           String
  brokerId         String
  platform         String // MT4, MT5
  server           String
  loginNumber      String // encrypted
  accountType      String // DEMO, LIVE
  metaapiAccountId String?
  nickname         String
  status           String    @default("DEPLOYMENT_PENDING")
  balance          Float     @default(0)
  equity           Float     @default(0)
  margin           Float     @default(0)
  freeMargin       Float     @default(0)
  leverage         Int?
  currency         String?
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker    Broker            @relation(fields: [brokerId], references: [id])
  snapshots AccountSnapshot[]
  trades    Trade[]

  @@index([userId])
  @@index([metaapiAccountId])
  @@map("broker_accounts")
}

model AccountSnapshot {
  id              String   @id @default(uuid())
  brokerAccountId String
  balance         Float
  equity          Float
  margin          Float
  freeMargin      Float
  openPositions   Int
  capturedAt      DateTime @default(now())

  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId, capturedAt])
  @@map("account_snapshots")
}

// ============================================
// SIGNAL SOURCES DOMAIN
// ============================================

model SignalSource {
  id         String   @id @default(uuid())
  userId     String
  sourceType String
  name       String
  isActive   Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SourceMessage[]
  channels TelegramChannel[]

  @@index([userId, sourceType])
  @@map("signal_sources")
}

model TelegramConnection {
  id              String    @id @default(uuid())
  userId          String
  sessionToken    String // encrypted
  phoneNumber     String // encrypted
  apiId           String
  apiHash         String
  isConnected     Boolean   @default(false)
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  channels TelegramChannel[]

  @@index([userId])
  @@map("telegram_connections")
}

model TelegramChannel {
  id                   String   @id @default(uuid())
  telegramConnectionId String
  signalSourceId       String
  channelId            String
  channelName          String
  channelType          String
  isMonitored          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  telegramConnection TelegramConnection @relation(fields: [telegramConnectionId], references: [id], onDelete: Cascade)
  signalSource       SignalSource       @relation(fields: [signalSourceId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("telegram_channels")
}

model SourceMessage {
  id                String    @id @default(uuid())
  signalSourceId    String
  externalMessageId String
  senderId          String?
  senderName        String?
  messageText       String
  mediaReference    String?
  rawPayload        String? // encrypted
  processingStatus  String    @default("PENDING")
  isEdited          Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  replyToMessageId  String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  signalSource SignalSource @relation(fields: [signalSourceId], references: [id], onDelete: Cascade)
  signals      Signal[]

  @@unique([signalSourceId, externalMessageId])
  @@index([processingStatus])
  @@map("source_messages")
}

// ============================================
// SIGNAL INTELLIGENCE DOMAIN
// ============================================

model Signal {
  id              String    @id @default(uuid())
  sourceMessageId String
  providerId      String?
  symbol          String?
  direction       String?
  entryType       String?
  entryPrice      Float?
  stopLoss        Float?
  takeProfit1     Float?
  takeProfit2     Float?
  takeProfit3     Float?
  timeframe       String?
  classification  String?
  status          String    @default("RAW")
  confidence      Float?
  rawText         String
  idempotencyKey  String    @unique
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sourceMessage SourceMessage      @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  parses        SignalParse[]
  validations   SignalValidation[]
  consensus     SignalConsensus[]
  trades        Trade[]

  @@index([symbol, direction])
  @@index([status])
  @@index([providerId])
  @@map("signals")
}

model SignalParse {
  id            String   @id @default(uuid())
  signalId      String
  parserType    String // FAST_PATH, LEARNING_PATH
  parserVersion String
  confidence    Float?
  aiModel       String?
  latencyMs     Int?
  result        Json?
  createdAt     DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("signal_parses")
}

model SignalValidation {
  id         String   @id @default(uuid())
  signalId   String
  checkName  String
  passed     Boolean
  severity   String
  message    String?
  executedAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("signal_validations")
}

model SignalFingerprint {
  id          String   @id @default(uuid())
  signalId    String
  fingerprint String   @unique
  createdAt   DateTime @default(now())

  @@map("signal_fingerprints")
}

model SignalConsensus {
  id         String   @id @default(uuid())
  signalId   String
  symbol     String
  direction  String
  confidence Float
  agreement  Int
  totalVotes Int
  createdAt  DateTime @default(now())

  signal  Signal                  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  members SignalConsensusMember[]

  @@map("signal_consensus")
}

model SignalConsensusMember {
  id          String @id @default(uuid())
  consensusId String
  signalId    String
  providerId  String
  direction   String
  confidence  Float

  consensus SignalConsensus @relation(fields: [consensusId], references: [id], onDelete: Cascade)

  @@map("signal_consensus_members")
}

// ============================================
// PROVIDER DOMAIN
// ============================================

model Provider {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  logoUrl      String?
  website      String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  qualityScore Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certifications ProviderCertification[]
  subscriptions  ProviderSubscription[]
  dna            ProviderDna?
  reviews        Review[]

  @@map("providers")
}

model ProviderCertification {
  id                String    @id @default(uuid())
  providerId        String
  status            String    @default("NOT_CERTIFIED")
  score             Float?
  certificationDate DateTime?
  expiryDate        DateTime?
  reportData        Json?
  createdAt         DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_certifications")
}

model ProviderSubscription {
  id            String   @id @default(uuid())
  userId        String
  providerId    String
  accountId     String?
  riskProfileId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("provider_subscriptions")
}

model ProviderDna {
  id            String   @id @default(uuid())
  providerId    String   @unique
  language      String?
  symbols       String[]
  abbreviations Json?
  patterns      Json?
  riskStyle     Json?
  confidence    Float?
  version       Int      @default(1)
  lastUpdated   DateTime @default(now())

  provider Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rules    ProviderDnaRule[]

  @@map("provider_dna")
}

model ProviderDnaRule {
  id            String   @id @default(uuid())
  providerDnaId String
  pattern       String
  action        String
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  providerDna ProviderDna @relation(fields: [providerDnaId], references: [id], onDelete: Cascade)

  @@map("provider_dna_rules")
}

// ============================================
// TRADING DOMAIN
// ============================================

model Trade {
  id              String    @id @default(uuid())
  userId          String
  brokerAccountId String
  signalId        String?
  providerId      String?
  symbol          String
  direction       String
  volume          Float
  entryPrice      Float?
  stopLoss        Float?
  takeProfit      Float?
  exitPrice       Float?
  commission      Float     @default(0)
  swap            Float     @default(0)
  realizedProfit  Float     @default(0)
  status          String    @default("PENDING")
  magicNumber     Int?
  ticketNumber    String?
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  signal        Signal?       @relation(fields: [signalId], references: [id])
  events        TradeEvent[]
  shadow        TradeShadow?

  @@index([userId, status])
  @@index([brokerAccountId])
  @@index([signalId])
  @@map("trades")
}

model TradeEvent {
  id        String   @id @default(uuid())
  tradeId   String
  eventType String
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_events")
}

model TradeShadow {
  id               String   @id @default(uuid())
  tradeId          String   @unique
  providerTradeId  String?
  missedProfit     Float?
  betterExit       Boolean  @default(false)
  behaviorFeedback String?
  createdAt        DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_shadows")
}

model RiskProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  riskPercent           Float    @default(1)
  maxDailyLoss          Float    @default(3)
  maxDrawdown           Float    @default(10)
  maxOpenTrades         Int      @default(5)
  tradingSessions       Json?
  trailingStop          Boolean  @default(false)
  breakEven             Boolean  @default(true)
  profitLock            Boolean  @default(false)
  partialClose          Boolean  @default(false)
  correlationProtection Boolean  @default(true)
  newsFilter            Boolean  @default(true)
  emergencyStop         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("risk_profiles")
}

model AutomationRule {
  id        String   @id @default(uuid())
  userId    String
  name      String
  condition Json
  action    Json
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_rules")
}

// ============================================
// PERFORMANCE DOMAIN
// ============================================

model PerformancePeriod {
  id                String   @id @default(uuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  openingBalance    Float
  closingBalance    Float?
  grossProfit       Float    @default(0)
  grossLoss         Float    @default(0)
  tradingCosts      Float    @default(0)
  eligibleNetProfit Float    @default(0)
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, periodStart, periodEnd])
  @@map("performance_periods")
}

model PerformanceMetric {
  id          String   @id @default(uuid())
  userId      String
  metricName  String
  metricValue Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@map("performance_metrics")
}

model EquitySnapshot {
  id         String   @id @default(uuid())
  userId     String
  equity     Float
  balance    Float
  capturedAt DateTime @default(now())

  @@index([userId, capturedAt])
  @@map("equity_snapshots")
}

// ============================================
// REFERRAL DOMAIN
// ============================================

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model ReferralRelationship {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  createdAt      DateTime @default(now())

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referral_relationships")
}

model ReferralReward {
  id                  String    @id @default(uuid())
  referrerId          String
  referredUserId      String
  performancePeriodId String
  eligibleNetProfit   Float
  rewardRate          Float
  rewardAmount        Float
  status              String    @default("PENDING")
  approvedAt          DateTime?
  settledAt           DateTime?
  createdAt           DateTime  @default(now())

  @@map("referral_rewards")
}

model ReferralWallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  pendingBalance    Float    @default(0)
  availableBalance  Float    @default(0)
  lifetimeEarned    Float    @default(0)
  lifetimeWithdrawn Float    @default(0)
  updatedAt         DateTime @updatedAt

  ledger ReferralLedger[]

  @@map("referral_wallets")
}

model ReferralLedger {
  id          String   @id @default(uuid())
  walletId    String
  entryType   String // CREDIT, DEBIT
  amount      Float
  reference   String
  description String?
  createdAt   DateTime @default(now())

  wallet ReferralWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("referral_ledger")
}

model ReferralSettlement {
  id             String    @id @default(uuid())
  periodStart    DateTime
  periodEnd      DateTime
  totalRewards   Float
  totalReferrers Int
  status         String    @default("PENDING")
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  @@map("referral_settlements")
}

// ============================================
// PAYMENTS DOMAIN
// ============================================

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  period      String // MONTHLY, YEARLY, LIFETIME
  features    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String
  planId             String
  status             String    @default("TRIAL")
  startDate          DateTime  @default(now())
  endDate            DateTime?
  autoRenew          Boolean   @default(false)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id             String    @id @default(uuid())
  subscriptionId String
  userId         String
  amount         Float
  currency       String    @default("USD")
  status         String    @default("PENDING")
  provider       String // PAYSTACK, STRIPE
  providerRef    String?
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============================================
// MARKETPLACE DOMAIN
// ============================================

model MarketplaceListing {
  id          String   @id @default(uuid())
  providerId  String
  title       String
  description String?
  category    String?
  price       Float?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("marketplace_listings")
}

model Review {
  id         String   @id @default(uuid())
  providerId String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model TraderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  bio         String?
  style       String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  followers TraderFollower[]

  @@map("trader_profiles")
}

model TraderFollower {
  id              String   @id @default(uuid())
  traderProfileId String
  followerId      String
  createdAt       DateTime @default(now())

  traderProfile TraderProfile @relation(fields: [traderProfileId], references: [id], onDelete: Cascade)

  @@unique([traderProfileId, followerId])
  @@map("trader_followers")
}

// ============================================
// AFFILIATE / IB DOMAIN
// ============================================

model AffiliatePartner {
  id             String   @id @default(uuid())
  userId         String
  code           String   @unique
  commissionRate Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("affiliate_partners")
}

model AffiliateReferral {
  id             String   @id @default(uuid())
  affiliateId    String
  referredUserId String
  createdAt      DateTime @default(now())

  @@map("affiliate_referrals")
}

model AffiliateCommission {
  id          String   @id @default(uuid())
  affiliateId String
  amount      Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("affiliate_commissions")
}

// ============================================
// WHITE LABEL DOMAIN
// ============================================

model WhiteLabelProject {
  id        String   @id @default(uuid())
  name      String
  domain    String
  branding  Json?
  theme     Json?
  pricing   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("white_label_projects")
}

// ============================================
// FINANCIAL OPS DOMAIN
// ============================================

model WithdrawalRequest {
  id             String    @id @default(uuid())
  userId         String
  amount         Float
  currency       String    @default("USD")
  status         String    @default("PENDING")
  paymentDetails Json?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@map("withdrawal_requests")
}

// ============================================
// SYSTEM DOMAIN
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  channels  String[]
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Job {
  id          String    @id @default(uuid())
  jobType     String
  payload     Json?
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, jobType])
  @@map("jobs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  permissions String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// ============================================
// SECURITY / AUDIT DOMAIN
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  result     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}
